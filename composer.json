{
  "name": "northrook/asset-manager",
  "description": "Manage optimised, public versions of assets from various sources.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Martin",
      "email": "mn@northrook.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Core\\": "src"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3",
    "ext-gd": "*",
    "ext-exif": "*",
    "intervention/image": "^3.11",
    "northrook/image": "dev-main",
    "northrook/core": "dev-main",
    "northrook/core-symfony": "dev-main",
    "northrook/pathfinder": "dev-main",
    "northrook/minify": "dev-main",
    "symfony/finder": "^7.2",
    "voku/portable-ascii": "^2.0"
  },
  "require-dev": {
    "northrook/dev": "dev-main",
    "northrook/view-document": "dev-main",
    "doctrine/orm": "^3.3",
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "phpstan": "vendor/bin/phpstan analyse src"
  }
}
